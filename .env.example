# ────────────────────────────────────────
# Dynamic QRIS Converter — Environment
# ────────────────────────────────────────
# Copy this file to .env and fill in the values.
# cp .env.example .env

# ── Server ───────────────────────────────
# Port the QRIS web server listens on
PORT=4009

# ── WhatsApp Gateway API ─────────────────
# Base URL of your WA gateway (e.g. go-whatsapp-web-multidevice)
# Do NOT include a trailing slash
WA_API_URL=http://localhost:3000

# Basic Auth credentials for the WA gateway
# Leave blank if your gateway does not require authentication
WA_USER=
WA_PASSWORD=

# Device ID (header X-Device-Id) when the gateway has multiple devices
# Leave blank to use the gateway's default device
WA_DEVICE_ID=

# ── Login ────────────────────────────────
# Password for the login page. Leave blank to disable login (not recommended
# unless the app is already behind an authenticating proxy).
APP_PASSWORD=

# Optional secret used to sign session cookies. When blank, a random one is
# generated at startup and everyone is logged out on restart.
SESSION_SECRET=
